{
  "manifest_version": 3,
  "name": "LeetCode AI Interviewer",
  "version": "0.1.0",
  "description": "Connects a LeetCode problem and editor to a local AI interviewer host.",
  "browser_specific_settings": {
    "gecko": {
      "id": "leetcode-ai-interviewer@local.invalid",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "LeetCode AI Interviewer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_bridge.js"
      ],
      "matches": [
        "https://leetcode.com/problems/*"
      ]
    }
  ]
}
